# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it's already in .gitignore.

# --- API keys ---
# Apify — https://console.apify.com/settings/integrations
APIFY_TOKEN=your_apify_token_here

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# Voyage AI — https://dashboard.voyageai.com/api-keys
VOYAGE_API_KEY=your_voyage_key_here


# --- Email delivery ---
# Two options: "resend" (recommended, no password) or "gmail" (SMTP + app password).
DELIVERY_METHOD=resend

# Where to send the digest. Your Gmail address is fine.
EMAIL_TO=you@gmail.com

# --- Resend (used when DELIVERY_METHOD=resend) ---
# Free tier: 100 emails/day, 3000/month. Rotatable from dashboard.
# 1. Sign up free at https://resend.com
# 2. Create an API key at https://resend.com/api-keys (starts with re_)
# 3. Paste below. No domain verification needed for personal use
#    (emails send from onboarding@resend.dev; inbox still shows your EMAIL_TO).
RESEND_API_KEY=
# Optional: override sender (requires verified domain in Resend dashboard).
# RESEND_FROM=LinkedIn Scraper <onboarding@resend.dev>

# --- Gmail SMTP (used when DELIVERY_METHOD=gmail) ---
# Requires 2FA on your Google account + 16-char app password.
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=


# --- Resume folder ---
# Defaults to ./resume — override if your PDFs live elsewhere.
# RESUME_DIR=/absolute/path/to/your/resume/folder


# --- Scraping volume / budget knobs ---
# Pipeline fans out to multiple Apify actors. Comma-separated, in priority
# order. Drop a source to save budget; all three ON = ~$1-2/day at default caps.
#   linkedin_posts  — harvestapi/linkedin-post-search  ($0.002/post, best signal)
#   linkedin_jobs   — worldunboxer/rapid-linkedin-scraper  (FREE)
#   naukri_jobs     — shahidirfan/Naukri-Jobs-Scraper     (FREE)
# ENABLED_SOURCES=linkedin_posts,linkedin_jobs,naukri_jobs

# How recent posts have to be to qualify. Default 7 (matches weekly digest).
# Lower = fresher, but fewer posts. Raise to 14 for thin days.
# POSTED_LIMIT_DAYS=7

# Per-query cap for paid harvestapi LinkedIn posts source. Keep modest — each
# post costs $0.002. 200 × ~10 queries × 4 tracks ≈ $16 worst case.
# MAX_POSTS_PER_QUERY=200

# Number of search queries to issue per track against the paid posts source.
# QUERIES_PER_TRACK=10

# Per-track cap for each FREE job-board source. Safe to raise — budget impact
# is zero. Default 500 → ~2000 items/track across both boards.
# MAX_LINKEDIN_JOBS_PER_TRACK=500
# MAX_NAUKRI_JOBS_PER_TRACK=500

# Top-K roles per track to push to job boards. Role list is ordered by
# preference in role_preferences.json — top 4 is the sweet spot (diminishing
# returns after that).
# ROLES_PER_JOB_BOARD_TRACK=4


# --- Matching thresholds ---
# Minimum cosine similarity for Voyage embedding match. Lower = wider funnel.
# SIMILARITY_THRESHOLD=0.62
# Top-N above similarity threshold sent to Claude Haiku reranker.
# LLM_RERANK_TOP_N=30
# Minimum Haiku fit-score (0-10) to survive into the email.
# LLM_SCORE_THRESHOLD=6.5


# --- Scrape soft deadline ---
# When running under a wall-clock cap (e.g. GitHub Actions timeout-minutes),
# the orchestrator stops starting NEW tracks once this many seconds elapse,
# then returns whatever was already collected to filter/match/rerank/deliver.
# Net effect: a slow Apify day still produces an email — just with fewer
# tracks populated — instead of the hard timeout killing the whole process
# and throwing everything away.
# Keep this at least ~20min under the workflow's timeout-minutes × 60 so the
# downstream stages always have room to finish.
# SCRAPE_SOFT_DEADLINE_SECONDS=2400
